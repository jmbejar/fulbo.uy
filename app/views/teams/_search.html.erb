<%= form_with url: teams_path, method: :get, role: "search",
      class: "relative order-4 basis-full md:order-none md:basis-[15em] lg:min-w-[9em]",
      data: { controller: "search", turbo_frame: "team_search", action: "input->search#submit keydown.esc->search#clear click@window->search#closeOutside" } do |form| %>
  <%= form.label :q, t("teams.search.label"), class: "sr-only" %>
  <%= form.search_field :q, placeholder: t("teams.search.label"), autocomplete: "off",
        data: { search_target: "input" },
        class: "h-[2.6em] w-full rounded-lg border-2 border-[#3A5680] bg-white px-3 text-[0.95rem] text-[#0B1320]" %>
  <%= turbo_frame_tag "team_search", target: "_top", class: "absolute inset-x-0 top-[2.9em] z-30 min-w-[16em]", data: { search_target: "results" } %>
<% end %>
