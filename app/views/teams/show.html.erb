<% content_for :title, @team.name %>
<div class="flex items-center gap-4 border-b-2 border-ink pb-5">
  <%= team_crest(@team, size: "size-[3.2em]") %>
  <div class="flex flex-col gap-1">
    <h1 class="text-[1.7rem] leading-tight font-bold md:text-[2.3rem]"><%= @team.name %></h1>
    <% if @team.city.present? %>
      <p class="text-[1.05rem] text-ink2"><%= @team.city %></p>
    <% end %>
  </div>
</div>

<section aria-labelledby="matches-heading" class="mt-6 max-w-[46rem]">
  <h2 id="matches-heading" class="mb-1 text-[1.35em] font-bold"><%= t(".matches") %></h2>
  <% if @matches.any? %>
    <% @matches.group_by(&:stage).each do |stage, matches| %>
      <h3 class="mt-5 mb-1 border-b-2 border-line pb-1.5 font-bold">
        <%= link_to "#{stage.season.competition.name} · #{stage.name}", competition_stage_path(stage.season.competition, stage), class: "text-ink" %>
      </h3>
      <% matches.each do |match| %>
        <p class="mt-2 text-[0.9em] text-ink2"><%= [ (round_label(match.round) if match.round), match_day(match.kicks_off_at&.to_date) ].compact.join(" · ") %></p>
        <%= render "matches/match", match: match %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-ink2"><%= t(".no_matches") %></p>
  <% end %>
</section>
