<%# locals: (competition:, stage:, round:) %>
<% if round %>
  <% rounds = stage.rounds %>
  <% index = rounds.index(round) %>
  <% previous_round, next_round = (rounds[index - 1] if index.positive?), rounds[index + 1] %>
  <% arrow = "flex size-[2.6em] shrink-0 items-center justify-center rounded-lg border-2 border-line bg-bg text-[1.15em] leading-none font-bold no-underline" %>
  <div class="flex items-center gap-2.5 rounded-[0.6rem] border border-line2 bg-soft p-2">
    <% if previous_round %>
      <%= link_to "‹", competition_stage_path(competition, stage, round: previous_round), class: "#{arrow} text-ink", aria: { label: t("stages.show.go_to", round: round_label(previous_round, stage: stage)) } %>
    <% else %>
      <span class="<%= arrow %> text-line" aria-hidden="true">‹</span>
    <% end %>
    <strong class="flex-1 text-center text-[1.25em]"><%= round_label(round, stage: stage) %></strong>
    <% if next_round %>
      <%= link_to "›", competition_stage_path(competition, stage, round: next_round), class: "#{arrow} text-ink", aria: { label: t("stages.show.go_to", round: round_label(next_round, stage: stage)) } %>
    <% else %>
      <span class="<%= arrow %> text-line" aria-hidden="true">›</span>
    <% end %>
  </div>

  <% matches = stage.matches.where(round: round).includes(:home_team, :away_team).chronological %>
  <% fixture_days(matches).each do |date, day_matches| %>
    <h3 class="mt-5 mb-1 border-b-2 border-line pb-1.5 font-bold <%= "text-accent" if date == Date.current %>"><%= match_day(date) %></h3>
    <%= render partial: "matches/match", collection: day_matches, as: :match %>
  <% end %>
<% else %>
  <p class="text-ink2"><%= t("stages.show.no_matches") %></p>
<% end %>
