<% content_for :title, "#{@stage.name} · #{@competition.name}" %>
<%= render "shared/competition_header", competition: @competition, season: @season, stage: @season.current_stage %>
<% standings = params[:view] == "standings" %>
<%= render "shared/view_switch", active: standings ? :standings : :matches,
      matches_path: competition_stage_path(@competition, @stage),
      standings_path: competition_stage_path(@competition, @stage, view: "standings") %>

<div class="mt-6 max-w-[46rem]">
  <% if standings %>
    <section aria-labelledby="standings-heading">
      <h2 id="standings-heading" class="mb-3 text-[1.35em] font-bold"><%= t(".standings") %></h2>
      <%= render "shared/tabs", competition: @competition, season: @season, active: @stage.slug %>
      <% if @stage.format_groups? %>
        <% @stage.groups.each do |group| %>
          <% cache [ @stage, group, @crests_version ] do %>
            <%= render "standings/table", rows: Standings::Table.for_stage(@stage, group: group).to_a, zones: @stage.zones,
                  title: group.name, caption: "#{@stage.name} · #{group.name}" %>
          <% end %>
        <% end %>
      <% else %>
        <% cache [ @stage, @crests_version ] do %>
          <%= render "standings/table", rows: Standings::Table.for_stage(@stage).to_a, zones: @stage.zones, caption: @stage.name %>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <section aria-labelledby="matches-heading">
      <h2 id="matches-heading" class="mb-3 text-[1.35em] font-bold"><%= @stage == @season.current_stage ? t(".matches") : t(".stage_matches", stage: @stage.name) %></h2>
      <%= render "stages/fixtures", competition: @competition, stage: @stage, round: @round %>
    </section>
  <% end %>
</div>
