<%# locals: (match:) %>
<% note = match_note(match) %>
<% sides = { home: match.home_team, away: match.away_team } %>
<% score_color = match.live? ? "text-live" : "text-ink" %>
<div class="flex flex-col gap-1.5 border-b border-line2 px-2 py-3 <%= "bg-live-soft" if match.live? %>">
  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.9em]">
    <%= match_status(match) %>
    <% if note %><span class="text-ink2"><%= note %></span><% end %>
  </p>

  <%# Phones: one team per line, its goals on the right. %>
  <div class="flex flex-col gap-1.5 md:hidden">
    <% sides.each do |side, team| %>
      <%= link_to team_path(team), class: "flex items-center gap-3 text-ink no-underline hover:underline" do %>
        <%= team_crest(team) %>
        <span class="min-w-0 flex-1 text-[1.15em] leading-tight break-words <%= "font-bold" if match_winner?(match, side) %>"><%= team.name %></span>
        <% if match.score? %>
          <span class="text-[1.4em] font-bold tabular-nums <%= score_color %>"><%= side == :home ? match.home_goals : match.away_goals %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <p class="hidden grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 md:grid">
    <%= link_to team_path(match.home_team), class: "flex items-center justify-end gap-2.5 text-right text-ink no-underline hover:underline" do %>
      <span class="min-w-0 text-[1.15em] leading-tight break-words <%= "font-bold" if match_winner?(match, :home) %>"><%= match.home_team.name %></span>
      <%= team_crest(match.home_team) %>
    <% end %>
    <span class="min-w-[3.4em] text-center text-[1.45em] font-bold whitespace-nowrap tabular-nums <%= score_color %>">
      <%= match_score(match) %>
    </span>
    <%= link_to team_path(match.away_team), class: "flex items-center gap-2.5 text-ink no-underline hover:underline" do %>
      <%= team_crest(match.away_team) %>
      <span class="min-w-0 text-[1.15em] leading-tight break-words <%= "font-bold" if match_winner?(match, :away) %>"><%= match.away_team.name %></span>
    <% end %>
  </p>
</div>
