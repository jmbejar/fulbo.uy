<% content_for :title, "#{t(".title")} · #{@competition.name}" %>
<% stage = @season.current_stage %>
<%= render "shared/competition_header", competition: @competition, season: @season, stage: stage %>
<%= render "shared/view_switch", active: :standings,
      matches_path: competition_stage_path(@competition, stage),
      standings_path: relegation_competition_path(@competition) %>

<section aria-labelledby="standings-heading" class="mt-6 max-w-[46rem]">
  <h2 id="standings-heading" class="mb-3 text-[1.35em] font-bold"><%= t("stages.show.standings") %></h2>
  <%= render "shared/tabs", competition: @competition, season: @season, active: "relegation" %>
  <% years = ((@season.year - @season.relegation_years + 1)..@season.year).to_a %>
  <p class="mb-2 text-ink2"><%= t(".description", years: years.to_sentence) %></p>
  <%= render "standings/table", rows: @rows, zones: @season.relegation_zones, caption: t(".title"), average: true %>
</section>
