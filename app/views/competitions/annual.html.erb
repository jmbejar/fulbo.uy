<% content_for :title, "#{t(".title")} · #{@competition.name}" %>
<%= render "shared/competition_header", competition: @competition, season: @season %>

<%= turbo_frame_tag "competition" do %>
  <%= render "shared/tabs", competition: @competition, season: @season, active: "annual" %>

  <h2 class="mb-1 text-lg font-semibold"><%= t(".title") %></h2>
  <p class="mb-3 text-sm text-slate-600"><%= t(".description", stages: @season.annual_stages.map(&:name).to_sentence) %></p>
  <% cache [ @season, :annual, @season.stages.maximum(:updated_at) ] do %>
    <%= render "standings/table", table: @table, zones: @season.annual_zones %>
  <% end %>
  <%= zone_legend(@season.annual_zones) %>
<% end %>
