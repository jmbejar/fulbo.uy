<!DOCTYPE html>
<html lang="es-UY">
  <head>
    <title><%= [content_for(:title), t("app.name")].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= t("app.tagline") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Applies the reader's saved text size and theme before the first paint. %>
    <script>
      try {
        const root = document.documentElement
        root.dataset.size = localStorage.getItem("size") || "medium"
        root.dataset.theme = localStorage.getItem("theme") ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
      } catch (e) {}
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Barlow+Condensed:ital,wght@1,800&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-bg font-sans text-ink antialiased">
    <header class="bg-head text-white">
      <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-x-6 gap-y-2 px-4 pt-2.5 pb-3 md:px-8 md:py-3">
        <%= link_to root_path, class: "flex shrink-0 items-center gap-1 font-logo text-[1.75rem] leading-none font-extrabold italic text-white no-underline", aria: { label: t(".home") } do %>
          Fulbo<span class="rounded-[0.12em] bg-cel px-[0.3em] pt-[0.12em] pb-[0.05em] text-[0.63em] text-navy">UY</span>
        <% end %>

        <nav aria-label="<%= t(".competitions") %>" class="order-3 flex basis-full gap-1.5 overflow-x-auto [scrollbar-width:none] md:order-none md:basis-auto">
          <% Competition.by_tier.each do |competition| %>
            <% current = competition == @competition %>
            <%= link_to competition.name, competition_path(competition),
                  aria: { current: ("page" if current) },
                  class: "flex min-h-[2.6em] shrink-0 items-center rounded-lg px-[0.95em] font-bold whitespace-nowrap no-underline #{current ? "bg-white text-navy" : "text-[#E6EEF7] hover:bg-white/10"}" %>
          <% end %>
        </nav>

        <span class="hidden flex-1 md:block"></span>

        <%= render "teams/search" %>
      </div>
    </header>

    <div class="border-b border-line2 bg-soft" data-controller="preferences">
      <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-end gap-x-5 gap-y-2 px-4 py-2 md:px-8">
        <div role="group" aria-label="<%= t(".text_size") %>" class="flex items-center gap-2">
          <span class="text-ink2"><%= t(".text_size") %></span>
          <% { "small" => ["min-w-9 h-9 text-[0.8rem]", t(".size_small")],
               "medium" => ["min-w-10 h-10 text-base", t(".size_medium")],
               "large" => ["min-w-11 h-11 text-[1.2rem]", t(".size_large")] }.each do |size, (classes, label)| %>
            <button type="button" aria-label="<%= label %>" aria-pressed="false"
                    data-preferences-target="size" data-size="<%= size %>" data-action="preferences#setSize"
                    class="<%= classes %> flex cursor-pointer items-center justify-center rounded-md border-2 border-line bg-bg font-bold text-ink aria-pressed:border-chip aria-pressed:bg-chip aria-pressed:text-on-chip">A</button>
          <% end %>
        </div>
        <button type="button" aria-pressed="false" data-preferences-target="dark" data-action="preferences#toggleDark"
                class="h-11 cursor-pointer rounded-md border-2 border-line bg-bg px-4 font-bold text-ink">
          <%= t(".dark_mode") %>
        </button>
      </div>
    </div>

    <main class="mx-auto w-full max-w-[1240px] flex-1 px-4 pt-5 pb-6 md:px-8 md:pt-8 md:pb-10">
      <%= yield %>
    </main>

    <footer class="border-t border-line2">
      <div class="mx-auto flex max-w-[1240px] flex-wrap gap-x-6 gap-y-1 px-4 py-4 text-[0.85rem] text-ink2 md:px-8">
        <strong class="text-ink"><%= t("app.name") %></strong>
        <span>
          <%= t("app.sources") %>
          <%= link_to "AUF", "https://www.auf.org.uy/", class: "underline" %>,
          <%= link_to "Tenfield Estadísticas", "https://estadisticas.tenfield.com.uy/", class: "underline" %>
          <%= t("app.and") %>
          <%= link_to "Wikipedia", "https://es.wikipedia.org/", class: "underline" %>
          (<%= link_to "CC BY-SA", "https://creativecommons.org/licenses/by-sa/4.0/deed.es", class: "underline" %>).
        </span>
      </div>
    </footer>
  </body>
</html>
