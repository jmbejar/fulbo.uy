<%# locals: (competition:, season:, active:) %>
<% tabs = season.stages.map { |stage| [ stage.slug, stage.name, competition_stage_path(competition, stage, view: "standings") ] } %>
<% tabs << [ "annual", t("competitions.tabs.annual"), annual_competition_path(competition) ] if season.annual? %>
<% tabs << [ "relegation", t("competitions.tabs.relegation"), relegation_competition_path(competition) ] if season.relegation? %>
<nav aria-label="<%= t("competitions.tabs.label") %>" class="mb-3 flex flex-wrap gap-1 rounded-[0.6rem] border border-line2 bg-soft p-1">
  <% tabs.each do |key, label, path| %>
    <%= link_to label, path,
          aria: { current: ("page" if key == active) },
          class: "flex min-h-[2.5em] grow items-center justify-center rounded-lg px-3 font-bold whitespace-nowrap no-underline #{key == active ? "bg-chip text-on-chip" : "text-ink hover:bg-bg"}" %>
  <% end %>
</nav>
