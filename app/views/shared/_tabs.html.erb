<%# locals: (competition:, season:, active:) %>
<% tab_class = ->(key) { key == active ? "border-sky-700 text-sky-800" : "border-transparent text-slate-600 hover:text-slate-900" } %>
<nav class="mb-5 flex gap-1 overflow-x-auto border-b border-slate-200 text-sm font-medium">
  <% season.stages.each do |stage| %>
    <%= link_to stage.name, competition_stage_path(competition, stage),
          class: "whitespace-nowrap border-b-2 px-3 py-2 #{tab_class.(stage.slug)}",
          data: { turbo_frame: "competition", turbo_action: "advance" } %>
  <% end %>
  <% if season.annual? %>
    <%= link_to t("competitions.tabs.annual"), annual_competition_path(competition),
          class: "whitespace-nowrap border-b-2 px-3 py-2 #{tab_class.("annual")}",
          data: { turbo_frame: "competition", turbo_action: "advance" } %>
  <% end %>
  <% if season.relegation? %>
    <%= link_to t("competitions.tabs.relegation"), relegation_competition_path(competition),
          class: "whitespace-nowrap border-b-2 px-3 py-2 #{tab_class.("relegation")}",
          data: { turbo_frame: "competition", turbo_action: "advance" } %>
  <% end %>
</nav>
