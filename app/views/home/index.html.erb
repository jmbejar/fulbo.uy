<% content_for :title, t(".title") %>

<section class="mb-8 grid gap-4 sm:grid-cols-3">
  <% @competitions.each do |competition| %>
    <% season = competition.current_season %>
    <% stage = season&.current_stage %>
    <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="text-lg font-bold"><%= competition.name %></h2>
      <% if stage %>
        <p class="text-sm text-slate-600"><%= stage.name %> <%= season.year %></p>
        <% leader = (stage.format_groups? ? nil : Standings::Table.for_stage(stage).first) %>
        <% if leader&.played&.positive? %>
          <p class="mt-2 text-sm"><%= t(".leader", stage: stage.name) %>: <strong><%= leader.team.name %></strong> (<%= leader.points %> pts)</p>
        <% end %>
      <% end %>
      <%= link_to t(".see_standings"), competition_path(competition), class: "mt-3 inline-block text-sm font-medium text-sky-700 hover:underline" %>
    </div>
  <% end %>
</section>

<div class="grid gap-6 lg:grid-cols-2">
  <section>
    <h2 class="mb-2 text-lg font-semibold"><%= t(".latest_results") %></h2>
    <% if @latest_matches.any? %>
      <ul class="divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
        <%= render partial: "matches/match", collection: @latest_matches, as: :match, locals: { show_competition: true } %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500"><%= t(".no_matches") %></p>
    <% end %>
  </section>
  <section>
    <h2 class="mb-2 text-lg font-semibold"><%= t(".upcoming") %></h2>
    <% if @upcoming_matches.any? %>
      <ul class="divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
        <%= render partial: "matches/match", collection: @upcoming_matches, as: :match, locals: { show_competition: true } %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500"><%= t(".no_matches") %></p>
    <% end %>
  </section>
</div>
